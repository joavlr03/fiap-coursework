  <folder name="Strategy" id="id-818d1c84fff24d79bbbb10524118c97f" type="strategy"/>
  <folder name="Business" id="id-bc30ef52b064440f8a8c63061b50ef97" type="business"/>
  <folder name="Application" id="id-154110c25828486590cde633c4d18e0d" type="application"/>
  <folder name="Technology &amp; Physical" id="id-cd537a9bce1b47c8adf8ba102583dbe9" type="technology"/>
  <folder name="Motivation" id="id-20435361ccea4b8a990e02298e4733f0" type="motivation">
    <element xsi:type="archimate:Stakeholder" name="Presidente da Softwarehouse Super Solucoes" id="id-e81e5458ab344741ad53a0671bac40ab"/>
    <element xsi:type="archimate:Driver" name="Formalizar todo atendimento de suporte" id="id-dc015ede18c044f8b11b826fed205d37"/>
    <element xsi:type="archimate:Driver" name="Conhecer o desenpenho da equipe de suporte" id="id-fd2e4199deeb45bca99de411da5f1d8a"/>
    <element xsi:type="archimate:Driver" name="Conhecer o nível de satisfação dos clientes" id="id-fce379a19c0f4f528d44b1413fd31a6c"/>
    <element xsi:type="archimate:Principle" name="Entre os indicadores de desempenho é obrigatório a medição do ciclo de atendimento do tempo de ciclo de atendimento do registro à solução do chamado " id="id-702d8b66501e4aaa98e7f0abac9d3863"/>
    <element xsi:type="archimate:Principle" name="Coletar feedback de todos os clientes que abriram chamados técnicos" id="id-bfdc7d10a76748c889393dda309eb72a"/>
    <element xsi:type="archimate:Principle" name="Todo chamado técnico deve ser registrado em um sistema, permitindo a recuperaçãoda informação e acompanhamento do atendimento " id="id-fc310f049a5d460f8c7431f5df39b48c"/>
    <element xsi:type="archimate:Goal" name="Realizar pesquisa de satisfacao com o cliente atendido" id="id-128d29eedbe7406ba36843b56d436f9c"/>
    <element xsi:type="archimate:Goal" name="Gerar métricas que apontem a performance dos atendentes de suporte " id="id-7349c3698417437e89e5e35748e9e6db"/>
    <element xsi:type="archimate:Goal" name="Workflow para registrar, movimentar e solucionar chamados técnicos" id="id-9e18f9c711e84453839ee537a9077ed1"/>
    <element xsi:type="archimate:Outcome" name="garantir que 100% dos chamados com atendimento finalizado tenham disparo de pesquisa de satisfaçao " id="id-9f9833db77ff45e0b8ca612ba8bee9cd"/>
    <element xsi:type="archimate:Outcome" name="Os indicadores de desempenho serao mapeados contra o SLA (Acordo de nivel de serviço/metas)" id="id-f2a5c081712447f98fcf495d74104a7c"/>
    <element xsi:type="archimate:Outcome" name="Alta disponibilidade e acessibilidade do sistema de registro e acompanhamento de chamados" id="id-5d475053b6a74ad2842ec9ef87755013"/>
    <element xsi:type="archimate:Assessment" name="Usar um meio de comunicação digital usual dos clientes" id="id-bdf9c9bc19984bb79d654b9eb422ff8a"/>
    <element xsi:type="archimate:Assessment" name="Disponibilizar os dados do sistema transacional  de Help Desk para serem consultados na solução de BI que ja existe na empresa" id="id-90667d01417044de8585a2bc7a9c8190"/>
    <element xsi:type="archimate:Assessment" name="Desenvolver a aplicação do zero com tecnologia que permita mobilidade" id="id-23e183f7aebf4c6c86daa61ff97ce331"/>
  </folder>
