  <folder name="Motivation" id="id-b9bedde053174a4a9410737a31c08168" type="motivation">
    <element xsi:type="archimate:Stakeholder" name="Presidente da software house Super Solucoes" id="id-9a95cdbf32d04ffdb95f954eb5a2841d"/>
    <element xsi:type="archimate:Driver" name="Formalizar todo atendimento de suporte" id="id-fc5e4a42357f43f38403586191d175ad"/>
    <element xsi:type="archimate:Driver" name="Conhecer o desempenho da equipe de suporte" id="id-731be986309b4f1ba7be66f4a57b243c"/>
    <element xsi:type="archimate:Driver" name="Conhecer o nível de satisfação dos clientes" id="id-4d097b7889a749bf8f139f569b4a625b"/>
    <element xsi:type="archimate:Principle" name="Entre os indicadores de desempenho é obrigatória a medição do tempo de ciclo de atendimento do registro à solução do chamado" id="id-35dc08fca7d344deb6e8a71977b58c28"/>
    <element xsi:type="archimate:Principle" name="Coletar feedback de todos os clientes que abriram chamados técnicos" id="id-21bc2990b86842dab55f0303d977e4d1"/>
    <element xsi:type="archimate:Principle" name="Registrar dados sobre cada demanda feita no suporte, permitindo a recuperação da informação e acompanhamento do atendimento" id="id-d198853f86184a8690ad7ecbaca11f68"/>
    <element xsi:type="archimate:Goal" name="Realizar pesquisa de satisfação com o cliente atendido" id="id-f71d1925c0374c12a113c3290b5a77e8"/>
    <element xsi:type="archimate:Goal" name="Gerar métricas que apontem a performance dos atendentes de suporte" id="id-95654af5f08c4996b5c544719f30b008"/>
    <element xsi:type="archimate:Goal" name="Workflow para registrar, movimentar e solucionar chamados técnicos" id="id-2ffe21ade94949f3a527d5187818ab27"/>
    <element xsi:type="archimate:Outcome" name="Garantir que 100% dos chamados com atendimento finalizado tenham disparo de pesquisa de satisfação" id="id-9472c5b7d5a641a1b4d2e546f987cbba"/>
    <element xsi:type="archimate:Outcome" name="Os indicadores de desempenho serão mapeados contra o SLA (Acordo de nível de serviço/metas)" id="id-06c8ef458b4f48b98e0cbdab1f159449"/>
    <element xsi:type="archimate:Outcome" name="Alta disponibilidade e acessibilidade do sistema de registro e acompanhamento de chamados" id="id-2563888b885d4126951ceec3c240e83f"/>
    <element xsi:type="archimate:Assessment" name="Usar um meio de comunicação digital usual dos clientes" id="id-4f0ebedf05e04fbca04a9078adb881de"/>
    <element xsi:type="archimate:Assessment" name="Disponibilizar os dados do sistema transacional de Help Desk para serem consultados na solução de BI que já existe na empresa" id="id-b0a2fb8e029c40c28156af5ea4eb70c3"/>
    <element xsi:type="archimate:Assessment" name="Desenvolver a aplicação do zero com tecnologia que permita mobilidade" id="id-6cb8b84a7a1442699f5cc099a1de074e"/>
    <element xsi:type="archimate:Meaning" name="Meaning" id="id-849ac8eccf1b4088bf556c51f7ddc68a"/>
    <element xsi:type="archimate:Meaning" name="Meaning" id="id-ad438f11efeb4a9dbec94d08d72ae5ce"/>
    <element xsi:type="archimate:Requirement" name="Disparar pesquisa de satisfação" id="id-08fa76965a7b43b8bf3eed7e5382432c"/>
    <element xsi:type="archimate:Requirement" name="Coletar feedback do cliente" id="id-6878742239a44d0d8d947bdfd6b61bf7"/>
    <element xsi:type="archimate:Constraint" name="A cada chamado com atendimento concluído (solucionado), uma mensagem será enviada por e-mail, sendo que essa mensagem contém: texto padrão de apresentação da pesquisa, a identificação do problema original, descrição da solução, data e hora de fechamento do chamado e lista de itens de avaliação com opções fixas de resposta (listas de seleção)" id="id-5a96b74ea328486a982fd38515b5466c"/>
    <element xsi:type="archimate:Constraint" name="Uma aplicação de software vai ler as mensagens de resposta com os formulários de pesquisa preenchidos e guardar as opções de cada reposta em campos de dados do próprio chamado vinculado" id="id-db5775fe4a164d9fa5f2687e2ad1f4fd"/>
    <element xsi:type="archimate:Requirement" name="Registrar a demanda do cliente (chamado técnico)" id="id-9cc479f531f549f782439bcd2bd3dc36"/>
    <element xsi:type="archimate:Requirement" name="Registrar movimentação feita sobre o chamado para buscar solução (LOG)" id="id-34852effe1cd4beb9f3810346b767467"/>
    <element xsi:type="archimate:Requirement" name="Registrar detalhes da solução de um chamado" id="id-bb94fa6b18ee4e8281ba711e03e9c8e0"/>
    <element xsi:type="archimate:Constraint" name="Consultar o cliente pela identificação da empresa dele, verificando se tem direito ao suporte. Para clientes com suporte, registrar a ocorrência imputando os detalhes: nome do demandante e o seu e-mail e telefone de contato, descrição do problema. Ao inserir um novo chamado, o sistema deve gerar e mostrar um protocolo de registro e vincular esse protocolo mais, o status EM ABERTO e a data e hora de abertura com o chamado no banco de dados" id="id-b196e31c1a0b48d98c7455c778cb2e86"/>
    <element xsi:type="archimate:Constraint" name="Consultar a lista de chamados em ordem de data de inclusão, com status EM ABERTO, filtrando por perfil de especialidade técnica. O analista de suporte deve descrever as ações que excutou e resultados que chegou, registrando isso no sistema. O sistema guarda um LOG com a identificação do chamado, identificação do analista de suporte, descrição da ação e do resultado e data e hora da ação." id="id-dac32ee4f35e4281b141bb00798a9f21"/>
    <element xsi:type="archimate:Constraint" name="Consultar a lista de chamados em ordem de data de inclusão, com status EM ABERTO, filtrando por perfil de especialidade técnica. O analista de suporte deve descrever as ações que excutou e resultados que chegou, registrando isso no sistema. O sistema guarda um LOG com a identificação do chamado, identificação do analista de suporte, descrição da ação e do resultado e data e hora da ação, alterando o status para RESOLVIDO." id="id-053f4ee859eb4042b48191f9a081ad7f"/>
    <element xsi:type="archimate:Requirement" name="Carregar dados transacionais do sistema de suporte para o datamart do BI" id="id-08ff246efa5c4c1f9eed5fca68c3524b"/>
    <element xsi:type="archimate:Constraint" name="Uma aplicação de leitura, transformação e carga de dados deve ser implementada (ETL) para selecionar os dados do sistema transacional de suporte técnico, carregando bases de dados de um Data Mart do BI." id="id-bd4f35a483d640b0b59d21a115ca1ac1"/>
  </folder>
